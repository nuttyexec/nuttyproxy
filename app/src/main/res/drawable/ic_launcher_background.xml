<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: the instrument-panel tile.

  A radial gradient rather than a flat fill, so the icon still reads as a lit
  surface after an OEM mask crops it. Inline <aapt:attr> gradients need
  AAPT2 + API 24; minSdk here is 26.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="32.4"
                android:centerY="23.8"
                android:gradientRadius="124"
                android:startColor="#232830"
                android:endColor="#0E1013"/>
        </aapt:attr>
    </path>
</vector>
